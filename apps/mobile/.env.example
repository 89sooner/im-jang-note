# 임장노트 모바일 환경변수 예시 — 복사해서 .env 로 사용 (.env 는 커밋 금지)
# anon key 는 공개 가능(RLS로 보호). service_role 키는 절대 클라이언트에 두지 않는다(NFR-002).
# 외부 API 키(국토부/Kakao REST)는 Supabase Edge Function secret 에만 둔다(ADR-003/004).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 로컬 supabase CLI 사용 시 예:
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase status 로 출력되는 anon key>
